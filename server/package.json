{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import ./tests/setup.js --test",
    "seed": "node --env-file=.env scripts/seed.js",
    "make-admin": "node --env-file=.env scripts/makeAdmin.js",
    "sync-company-claims": "node --env-file=.env scripts/syncCompanyClaims.js",
    "get-token": "node --env-file=.env scripts/getToken.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.5.1",
    "serverless-http": "^4.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
