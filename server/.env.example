FIREBASE_PROJECT_ID=ipuente-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ipuente-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE\n-----END PRIVATE KEY-----\n"
PORT=3000
APP_URL=http://localhost:5173
# Mismo valor que VITE_FIREBASE_STORAGE_BUCKET del front.
FIREBASE_STORAGE_BUCKET=

# Stripe, solo modo prueba y las dos del mismo sandbox.
# La clave secreta empieza por sk_test_ o rk_test_ (la pk_test_ no sirve: es la publicable).
STRIPE_SECRET_KEY=
# Secreto de firma del webhook (empieza por whsec_).
STRIPE_WEBHOOK_SECRET=

# Solo para scripts locales.
# Clave web de Firebase para npm run get-token.
FIREBASE_WEB_API_KEY=
# Contraseña de los usuarios demo para npm run seed (mínimo 12 caracteres).
SEED_DEMO_PASSWORD=
