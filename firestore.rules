// Reglas de seguridad de Firestore: el navegador no lee ni escribe directamente; todos los datos pasan por la API,
// que usa firebase-admin (se salta estas reglas) y comprueba token, rol y propiedad.
// Si algún día el front necesita leer algo directamente, se abre solo esa lectura aquí.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
